{
	email {$ACME_EMAIL}
}

# API : tablettes, back-office et console. Certificat Let's Encrypt automatique.
{$API_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	request_body {
		max_size 6MB
	}
	reverse_proxy api:3000
}

# Back-office client et console BACYBRAINS : même application.
{$BACKOFFICE_DOMAIN}, {$CONSOLE_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy backoffice:3001
}
