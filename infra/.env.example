# Copier en .env et remplacer chaque valeur. Ne jamais commiter le fichier .env.

# Mot de passe PostgreSQL (générer : openssl rand -base64 32)
POSTGRES_PASSWORD=changer-moi

# Clé de signature des jetons, 32 caractères minimum (générer : openssl rand -base64 48)
JWT_SECRET=changer-moi-avec-au-moins-32-caracteres

# Domaines (enregistrements DNS A vers l'IP du VPS)
API_DOMAIN=api.caissebox.ma
BACKOFFICE_DOMAIN=app.caissebox.ma
CONSOLE_DOMAIN=console.caissebox.ma

# E-mail pour les certificats Let's Encrypt
ACME_EMAIL=contact@bacybrains.ma
